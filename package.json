{
  "name": "procon-ip",
  "version": "2.1.4",
  "description": "Library for the ProCon.IP pool controller",
  "license": "MIT",
  "homepage": "https://github.com/ylabonte/procon-ip#readme",
  "author": {
    "name": "Yannic Labonte",
    "email": "yannic.labonte@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/ylabonte/procon-ip/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:report": "vitest run --coverage --reporter=verbose",
    "docs": "typedoc",
    "docs:check": "typedoc --validation.invalidLink --validation.notExported --treatWarningsAsErrors",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylabonte/procon-ip.git"
  },
  "keywords": [
    "ProCon.IP",
    "pool",
    "controller",
    "library"
  ],
  "devDependencies": {
    "@changesets/cli": "^3",
    "@eslint/js": "^10",
    "@types/node": "^26",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.8",
    "tsdown": "^0.23.0",
    "typedoc": "~0.28.20",
    "typescript": "~7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "~5.0.1"
  }
}
